# ============================================================================
# ConcertMatch environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in values ONLY when you want to switch from
# the built-in mock adapters to the real APIs. The app runs fully in mock mode
# with NONE of these set.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# ============================================================================

# ---- Adapter selection ------------------------------------------------------
# Which music source to use: "mock" (default) | "spotify" | "ytmusic"
VITE_MUSIC_ADAPTER=mock

# Which events source to use: "mock" (default) | "ticketmaster"
VITE_EVENTS_ADAPTER=mock

# ---- Spotify Web API --------------------------------------------------------
# Get credentials at: https://developer.spotify.com/dashboard
# Create an app, then copy the Client ID/Secret. Add your redirect URI
# (e.g. http://localhost:5173/callback) to the app's settings.
# Docs: https://developer.spotify.com/documentation/web-api
VITE_SPOTIFY_CLIENT_ID=
# NOTE: the client secret must NEVER ship in a browser bundle. Use it only in a
# backend token exchange (Authorization Code + PKCE keeps the secret optional).
SPOTIFY_CLIENT_SECRET=
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback

# ---- YouTube Music / YouTube Data API --------------------------------------
# YouTube Music has no official public API. Two documented options:
#  (a) YouTube Data API v3 (OAuth) for a user's likes/subscriptions:
#      https://console.cloud.google.com/  ->  enable "YouTube Data API v3"
#      Docs: https://developers.google.com/youtube/v3
#  (b) An unofficial ytmusicapi-style backend (server-side only).
VITE_YTMUSIC_CLIENT_ID=
YTMUSIC_CLIENT_SECRET=
VITE_YTMUSIC_REDIRECT_URI=http://localhost:5173/callback

# ---- Ticketmaster Discovery API --------------------------------------------
# Get a key at: https://developer.ticketmaster.com/
# Register, create an app, copy the "Consumer Key". Free tier available.
# Docs: https://developer.ticketmaster.com/products-and-docs/apis/discovery-api/v2/
VITE_TICKETMASTER_API_KEY=
